# Copy this file to .env and fill in your own values. Never commit .env.

# Gemini (natural-language queries): create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: Gemini model to use
GEMINI_MODEL=gemini-3.5-flash-lite

# Address of the GEE-Assist authentication server (GEE-Assist-Backend repository).
AUTH_API_URL=http://localhost:8000
# Seconds to wait for the server before showing a connection error.
AUTH_API_TIMEOUT=15
